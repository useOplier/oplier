NODE_ENV=development
PORT=3001
HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oplier

# openssl rand -base64 32
JWT_ACCESS_SECRET=replace-with-a-real-32-plus-character-secret
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-character-secret

SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000

CORS_ORIGINS=http://localhost:3000

# ── LLM providers (packages/llm) ─────────────────────────────────────────────
# Read straight from process.env by packages/llm/src/providers/factory.ts — these
# are deliberately NOT in src/config/env.ts's zod schema, which means a missing
# key does not fail startup. The API boots fine and the FIRST CHAT MESSAGE throws
# instead. Fill these in before using /chats.
#
# Role -> provider. Valid values: deepseek | gemini | groq (master plan §1 locks
# these three: no Anthropic, no OpenAI, no xAI). Defaults if unset are
# LLM1=gemini, LLM2=groq, LLM3=groq (factory.ts:24-28) — so with no overrides you
# need BOTH a Gemini and a Groq key below.
#   LLM1 = conversation/reasoning   LLM2 = memory (runs on every message, so the
#   cheapest viable model)          LLM3 = compaction
LLM1_PROVIDER=gemini
LLM2_PROVIDER=groq
LLM3_PROVIDER=groq

# *_MODEL is REQUIRED for every provider you actually select — the factories throw
# when it is unset. That is deliberate (groq.provider.ts:13-16): a stale hardcoded
# default would start failing tool-calls silently after a model deprecation.
# Check the provider's current model list when filling these in — the ids rotate.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=replace-with-a-current-gemini-model-id
GROQ_API_KEY=your-groq-api-key
# Verified present on Groq 2026-08-19. Their catalogue is thin and rotates — check
# GET https://api.groq.com/openai/v1/models before trusting this value.
GROQ_MODEL=openai/gpt-oss-20b

# Only needed if you point one of the roles above at deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=

# Optional — each defaults to the provider's public endpoint. Set only to reach a
# proxy or pin a specific API version.
# GEMINI_BASE_URL=
# GROQ_BASE_URL=
# DEEPSEEK_BASE_URL=

# ── Web search (Tavily) ──────────────────────────────────────────────────────
# Optional, and declared in the schema (src/config/env.ts:50). When unset, the
# conversation turn falls back to a no-op TavilyClient instead of failing the turn
# over a missing search provider.
TAVILY_API_KEY=

# ── Self-call base URL ───────────────────────────────────────────────────────
# Optional (src/config/env.ts:43). URL this process uses to call its OWN REST
# endpoints, for the ApiClient injected into packages/llm. Defaults to loopback on
# the PORT above — set it only if that inference is wrong for your setup.
# INTERNAL_API_BASE_URL=http://127.0.0.1:3001
