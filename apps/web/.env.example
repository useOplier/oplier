# Part B API base URL. When unset, the frontend runs entirely against the
# built-in mock layer in src/lib/api — see README.md "What's mocked".
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Toggles the mock API layer explicitly regardless of API_BASE_URL reachability.
# "true" | "false". Defaults to "true" until Part B confirms the contract is live.
NEXT_PUBLIC_USE_MOCK_API=true

# WalletConnect / RainbowKit project id (get one at cloud.walletconnect.com).
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# X Layer testnet RPC (doc 08 / doc 01 §11-12) — chain id 1952 per OKX's
# official docs; wagmi.ts also carries a hardcoded fallback endpoint, so
# this only needs to be set to override the default.
NEXT_PUBLIC_XLAYER_TESTNET_RPC_URL=https://testrpc.xlayer.tech/terigon
NEXT_PUBLIC_XLAYER_TESTNET_CHAIN_ID=1952

# Web3Forms access key for the "Get notified when we launch on mainnet"
# modal (src/components/landing/NotifyMainnetCta.tsx). Web3Forms access
# keys are designed to be client-embedded, so this is fine as a
# NEXT_PUBLIC_ var — get one at https://web3forms.com.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=