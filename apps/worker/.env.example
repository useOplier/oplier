# Oplier UPM Worker — environment template.
#
# Copy to `.env` in this directory (apps/worker/.env) and fill in real values.
# NEVER commit `.env` (doc 08 §11: all of this is server-side only, never in frontend code).
# `pnpm --filter @oplier/worker run <script>` sets cwd to apps/worker/, which is where `.env` is read from.

# ── Database (shared with apps/api — doc 08 §5) ──────────────────────────────
# Supabase Postgres connection string. Use the POOLED connection string for the worker.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ── Monitoring cadence (LOCKED — doc 08 §5 / brief responsibility #5) ────────
# Price / price-percentage / ROI: must be 5000-10000ms. Values outside that range are rejected
# at startup, because the 5-10s window is a locked product decision, not a tunable.
# NOTE: this overrides doc 05 §17's original 60s price cycle.
PRICE_CYCLE_MS=7000
# High Impact News: 60s. Do not tighten.
NEWS_CYCLE_MS=60000
# TIME conditions — engine-level, not one of the two locked cadences.
TIME_CYCLE_MS=30000
# Activation/revocation reconciler. Also bounds how long a deleted System's session key
# stays live on-chain, so keep it short.
ACTIVATION_CYCLE_MS=15000

# ── Receipt polling (doc 05 §15) ─────────────────────────────────────────────
RECEIPT_POLL_INTERVAL_MS=3000
RECEIPT_MAX_WAIT_MS=45000

# ── Chain / RPC (doc 08 §11) ─────────────────────────────────────────────────
# X Layer testnet = 1952 (0x7A0). Mainnet is 196 — do not reuse the testnet id there.
CHAIN_ID=1952
# BOTH official OKX endpoints require the `/terigon` path suffix; a URL without it is not a
# working endpoint. The two are interchangeable — use either as primary, the other as fallback.
XLAYER_RPC_URL=https://testrpc.xlayer.tech/terigon
XLAYER_RPC_URL_FALLBACK=https://xlayertestrpc.okx.com/terigon

# ── Pyth (doc 05 §5) ─────────────────────────────────────────────────────────
PYTH_HERMES_ENDPOINT=https://hermes.pyth.network
# asset_registry.asset_id values to stream. USDG is deliberately absent (no confirmed Pyth feed;
# it uses the peg-check path instead).
# ⚠ The feed IDs behind these are UNVERIFIED, and test_meta's is deliberately malformed to force a
# real lookup. `pnpm --filter @oplier/worker run preflight` checks every one against Pyth's live
# registry and refuses to start on a bad id.
PYTH_STREAM_ASSETS=test_aapl,test_meta,test_nvda,test_gold
PRICE_FRESHNESS_THRESHOLD_MS=15000

# ── Alchemy Smart Wallets (doc 08 §11) ───────────────────────────────────────
ALCHEMY_API_KEY=
# The EXISTING dashboard-created gas sponsorship policy id — not a new one created programmatically.
ALCHEMY_GAS_MANAGER_POLICY_ID_XLAYER_TESTNET=

# ── Secrets: the two most sensitive values this process holds ────────────────
# Owner of the smart accounts; signs session grants and account-admin calls (revocation).
SMART_ACCOUNT_OWNER_PRIVATE_KEY=0x
# Master seed from which EVERY System's session key is derived (HKDF-SHA256 + systemId). This
# exists so no per-System private key is ever written to the database.
# ⚠ Rotating this orphans every existing session key — the worker will derive different keys and
# can no longer sign for sessions already granted on-chain. See DEPLOYMENT_RUNBOOK.md first.
# Generate with: openssl rand -hex 32
SESSION_KEY_MASTER_SEED=

# ── AMM (optional) ───────────────────────────────────────────────────────────
# Leave unset in normal operation. The Router address is a confirmed constant in both
# @oplier/permissions and @oplier/amm-execution; overriding means pointing at a different deployment.
# AMM_ROUTER_ADDRESS_OVERRIDE=

# ── Operational ──────────────────────────────────────────────────────────────
LOG_LEVEL=info
# true = evaluate conditions and log intended swaps, but never submit. Recommended for the FIRST
# boot against a live database, so a misconfiguration surfaces before any funds move.
DRY_RUN=false
