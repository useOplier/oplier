# packages/data-layer — ingestion job credentials
#
# ⚠ READ THIS FIRST: nothing in this package loads dotenv. `dotenv` is not even a
# dependency here (unlike apps/api and apps/worker, which both call config()).
# Copying this file to `.env` therefore does NOT make these vars available — the
# ingestion scripts read process.env directly and will exit 1 with a "required"
# message. Until dotenv is wired into the four entrypoints under
# src/ingestion/run-*-job.ts, pass them on the command line instead:
#
#   FRED_API_KEY=... pnpm --filter @oplier/data-layer run ingest:fred
#   BLS_API_KEY=...  pnpm --filter @oplier/data-layer run ingest:bls
#   SEC_EDGAR_USER_AGENT="Oplier you@example.com" \
#                        pnpm --filter @oplier/data-layer run ingest:edgar
#   pnpm --filter @oplier/data-layer run ingest:fed      # no key needed
#
# ⚠ ALSO: these four scripts construct InMemoryNewsRepository and
# InMemoryFundamentalEventStore — they print their result and exit WITHOUT writing
# anything to Postgres. They are verification harnesses for the client adapters,
# not a working ingestion pipeline. Separately, the two LLM tools that would expose
# this data to a user (getHighImpactNews, getFundamentalData) currently throw
# notImplemented in apps/api/src/modules/chats/api-client.ts. So supplying these
# keys buys you a manual smoke test of the upstream clients and nothing further
# until both gaps are closed.

# FRED (St. Louis Fed) — free key, register at fredaccount.stlouisfed.org.
# Required by ingest:fred; the script exits 1 without it.
FRED_API_KEY=

# BLS (Bureau of Labor Statistics) — free registration key.
# OPTIONAL for ingest:bls: the job passes it through as `blsApiKey: undefined` when
# unset, which uses BLS's unregistered tier (lower daily limits, fewer series).
BLS_API_KEY=

# SEC EDGAR requires a self-identifying User-Agent on every request — SEC blocks
# traffic without one. Format is "Organisation contact@email"; use a real address.
# Required by ingest:edgar; the script exits 1 without it.
SEC_EDGAR_USER_AGENT=Oplier you@example.com
