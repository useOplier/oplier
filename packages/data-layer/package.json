{
  "name": "@oplier/data-layer",
  "version": "0.1.0",
  "private": true,
  "description": "Part D+J: Pyth market prices + BLS/FRED/Fed/SEC EDGAR fundamental data + High Impact News classification",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
